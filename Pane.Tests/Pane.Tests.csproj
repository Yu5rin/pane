<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      本体(Pane.csproj)は net8.0-windows の WinForms アプリで、Windows でしか動かない。
      テストまで Windows 専用にすると、CI(Linux)でも手元の Linux でも実行できなくなる。
      そこで、外の世界に触れないクラスだけをソースごと取り込み、このプロジェクト自体は
      素の net8.0 に保つ。取り込んだクラスは同じアセンブリの一部になるので、internal の
      ままテストから触れる(InternalsVisibleTo を足す必要がない)。
    -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Windows 依存を持たないクラスだけをここに並べる。本体側でこのファイルに Windows 専用の
      API を持ち込むと、このプロジェクトのビルドが壊れて気づける(それがこの構成の狙いでもある)。
    -->
    <Compile Include="../Pane/UpdateCheckLogic.cs" Link="取り込み/UpdateCheckLogic.cs" />
    <Compile Include="../Pane/LogReviewLogic.cs" Link="取り込み/LogReviewLogic.cs" />
    <Compile Include="../Pane/LargeFileGuard.cs" Link="取り込み/LargeFileGuard.cs" />
    <Compile Include="../Pane/UpdateLeftoverPolicy.cs" Link="取り込み/UpdateLeftoverPolicy.cs" />
    <Compile Include="../Pane/FileEncodingKind.cs" Link="取り込み/FileEncodingKind.cs" />
    <Compile Include="../Pane/EncodingLossGuard.cs" Link="取り込み/EncodingLossGuard.cs" />
    <Compile Include="../Pane/StartupPathResolver.cs" Link="取り込み/StartupPathResolver.cs" />
    <Compile Include="../Pane/TabSnapshotCleanup.cs" Link="取り込み/TabSnapshotCleanup.cs" />
    <Compile Include="../Pane/SettingsRecoveryLogic.cs" Link="取り込み/SettingsRecoveryLogic.cs" />
    <Compile Include="../Pane/ExternalToolLocator.cs" Link="取り込み/ExternalToolLocator.cs" />
    <Compile Include="../Pane/PrivacyLogFormatter.cs" Link="取り込み/PrivacyLogFormatter.cs" />
    <Compile Include="../Pane/OpenDialogFilterBuilder.cs" Link="取り込み/OpenDialogFilterBuilder.cs" />
    <Compile Include="../Pane/FileTypes.generated.cs" Link="取り込み/FileTypes.generated.cs" />
    <Compile Include="../Pane/ExceptionMessages.cs" Link="取り込み/ExceptionMessages.cs" />
    <Compile Include="../Pane/NavigationGuard.cs" Link="取り込み/NavigationGuard.cs" />
    <Compile Include="../Pane/MenuNoteFormatter.cs" Link="取り込み/MenuNoteFormatter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!-- EncodingLossGuard(Shift_JIS判定)のテストに必要。本体側(Pane.csproj)と同じ理由
         (Program.cs参照)で、.NETは既定でコードページ932を同梱しないため。
         登録はEncodingLossGuardTests.csのモジュール初期化子で行う。 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
