<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pane</RootNamespace>
    <AssemblyName>Pane</AssemblyName>
    <ApplicationIcon>Assets\Pane.ico</ApplicationIcon>

    <!-- バージョン。利用者に見せる表記は3桁(セマンティックバージョニング)に揃える。
         .NETのAssemblyVersion/FileVersionは仕様上どうしても4桁(Major.Minor.Build.Revision)に
         なりexeのプロパティにもその形で出るが、設定の「バージョン情報」に表示するのは
         ここで指定した<Version>から作られるInformationalVersion("1.1.0")を使う
         (SettingsBridge.DetectAppVersion参照)。 -->
    <Version>1.1.0</Version>

    <!-- Windowsデスクトップワークロードが無い環境(Linux/mac上のCIやこのリポジトリの
         開発環境)でもビルド検証できるようにする。Windows上のビルドには影響しない。 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- self-contained・単一exe出力(仕様書 第7章・第8.1節) -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- ネイティブDLL(WebView2Loader.dll等)は仕組み上メモリから直接ロードできないため、
         起動時に一時フォルダへ展開する必要がある。ここはtrueのまま。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- IncludeAllContentForSelfExtract は「マネージドアセンブリも含めて全部を一時フォルダへ
         展開してから実行する」という .NET Core 3.x 互換の動作で、Microsoftの公式ドキュメントでも
         非推奨とされている(既定のfalseでは、マネージドアセンブリはexeから直接メモリへ読み込まれ、
         展開そのものが起きない)。

         これを有効にしていたため、self-contained(約190MB)の中身をまるごとディスクへ書き出す
         処理が起動のたびに走っていた。実機ログの計測では、OSのファイルキャッシュに乗っていない
         初回起動で「プロセス開始→Main到達」に1968ms、その後のWebView2アセンブリ読み込みに
         3134msかかっており、合計13.3秒という起動時間の主因になっていた
         (キャッシュに乗った2回目以降は同区間が約290ms/0msまで縮む)。

         外すにあたって確認したこと:
           - dist/ の解決は AppContext.BaseDirectory ではなく Environment.ProcessPath を
             使っている(MainForm.ResolveDistPath)ため、展開先が変わっても影響しない。
           - 唯一 AppContext.BaseDirectory 配下のファイルを読んでいたウィンドウアイコンは、
             アセンブリへの埋め込み(下のEmbeddedResource + Pane/AppIcon.cs)へ移した。 -->

    <!-- 事前コンパイル(ReadyToRun)。起動時にJITでネイティブコードへ変換していた分を
         ビルド時に済ませておき、「プロセス開始→Main到達」を短くする。
         PublishTrimmedはWinFormsがCOMマーシャリングに依存するためSDK側で無効化されており、
         こちらは併用できない。

         既定はfalse。有効にすると配布物が目に見えて大きくなるため
         (win-x64 self-contained での実測: exe 180MB→238MB、Zip 71.9MB→88.2MB)、
         得られる短縮幅(実機の計測ログで「プロセス開始→Main到達」がどれだけ縮むか)を
         測ったうえで判断する。切り替えは scripts\release.ps1 の -ReadyToRun スイッチ、
         または `dotnet publish -p:PublishReadyToRun=true` で行う。 -->
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shift_JIS(コードページ932)を扱うために必要。.NETは既定でANSI系コードページを
         同梱しないため、起動時に CodePagesEncodingProvider を登録する(Program.cs参照)。 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- ウィンドウアイコン。exeの隣にファイルとして置くのではなくアセンブリへ埋め込む。
         単一ファイル発行の展開方式(IncludeAllContentForSelfExtract)に左右されず、
         開発ビルドでも配布ビルドでも同じ経路で読めるようにするため(Pane/AppIcon.cs参照)。
         LogicalNameはAppIcon.ResourceNameと一致させること。
         なお、exe自体のアイコン(エクスプローラーに出るもの)は上の<ApplicationIcon>が担当しており、
         こちらとは別の仕組み。 -->
    <EmbeddedResource Include="Assets\Pane.ico" LogicalName="Pane.Assets.Pane.ico" />
  </ItemGroup>

  <!-- FileTypes.generated.cs は `npm run build`(scripts/build.js)が src/file-types.js から
       生成する。Gitで追跡するとビルドのたびに差分が出てpullを妨げるため追跡対象から外してあり、
       クローン直後には存在しない。先に `npm run build` を実行する必要があることを、
       分かりにくいコンパイルエラーではなく明示的なメッセージで伝える。 -->
  <Target Name="EnsureFileTypesGenerated" BeforeTargets="BeforeCompile">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\FileTypes.generated.cs')"
           Text="Pane/FileTypes.generated.cs がありません。先にリポジトリ直下で `npm install` と `npm run build` を実行してください(src/file-types.js から自動生成されます)。" />
  </Target>

  <!-- リリースビルド(dotnet publish)は実行ファイルと同階層のdist/を探す(MainForm.ResolveDistPath参照)。
       PublishSingleFileはContent項目を単一exeへ埋め込むためdist/(npm run buildの成果物)は対象外になるので、
       publish完了後に手動でリポジトリ直下のdist/をpublish出力へコピーする(先に `npm run build` 済みであること)。 -->
  <Target Name="CopyDistToPublishDir" AfterTargets="Publish" Condition="Exists('$(MSBuildProjectDirectory)\..\dist')">
    <ItemGroup>
      <DistFiles Include="$(MSBuildProjectDirectory)\..\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DistFiles)" DestinationFiles="@(DistFiles->'$(PublishDir)dist\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
